---
import { HOME } from '@/const/home'
---

<div
  class="pointer-events-none flex min-h-32 items-center justify-center lg:absolute lg:inset-0 lg:min-h-0"
  data-panel-placeholder
  aria-hidden="true"
>
  <div class="grid justify-items-center gap-1 text-center font-mono uppercase leading-none">
    <p
      class="m-0 inline-flex items-center gap-2 text-[10px] tracking-[0.08em] text-[var(--color-muted)]"
    >
      <span class="beacon-dot" aria-hidden="true"></span>
      {HOME.origin.label}
    </p>
    <p class="m-0 text-[11px] tracking-[0.06em] text-[var(--color-text)] opacity-70">
      {HOME.origin.coordinates}
    </p>
  </div>
</div>

<style>
  .beacon-dot {
    width: 0.28125rem;
    height: 0.28125rem;
    border-radius: 9999px;
    background: var(--color-muted);
    box-shadow: 0 0 0.375rem color-mix(in srgb, var(--color-muted) 38%, transparent);
    opacity: 0.68;
    animation: beacon-presence 3.8s ease-in-out infinite;
  }

  @keyframes beacon-presence {
    0%,
    100% {
      opacity: 0.48;
      transform: scale(0.9);
    }

    45% {
      opacity: 0.82;
      transform: scale(1.08);
    }

    70% {
      opacity: 0.62;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .beacon-dot {
      animation: none;
      opacity: 0.68;
      transform: none;
    }
  }
</style>
