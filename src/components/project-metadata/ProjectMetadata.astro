---
import './ProjectMetadata.scss'

interface Props {
	items: {
		label: string
		value: string
	}[]
}

const { items } = Astro.props

function isMetaValue(label: string) {
	return label === 'Year' || label === 'Period'
}
---

<table class="metadata-table">
	<tbody>
		{items.map(item => (
			<tr>
				<th scope="row">{item.label}</th>
				<td class={isMetaValue(item.label) ? 'metadata-table__meta-value' : undefined}>
					{item.value}
				</td>
			</tr>
		))}
	</tbody>
</table>
