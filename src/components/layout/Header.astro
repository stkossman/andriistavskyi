---
import Logo from '@/components/common/Logo.astro'
import { MAIN_NAVIGATION, NAVIGATION_LABELS } from '@/const/navigation'
import { SITE_META } from '@/const/site'

const currentPath = Astro.url.pathname
---

<header class="grid w-full grid-cols-[auto_1fr] items-center gap-x-6 gap-y-3 px-[var(--site-page-padding)] py-3 md:grid-cols-[auto_1fr_auto] md:py-4">
  <a href="/" class="w-fit text-primary transition-colors duration-fast ease-smooth hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" aria-label={NAVIGATION_LABELS.HOME_ARIA_LABEL}>
    <Logo class="h-7 w-7 md:h-8 md:w-8" />
  </a>

  <nav class="flex min-w-0 flex-wrap items-center justify-end gap-x-4 gap-y-1 font-mono text-xs uppercase tracking-[var(--tracking-archive)] text-primary transition-colors duration-fast ease-smooth md:justify-center md:gap-x-7 [&:has(a:hover)_a]:text-secondary [&:has(a:hover)_a:hover]:text-primary">
    {MAIN_NAVIGATION.map((item: { href: string; label: string }) => {
      const isActive = currentPath.startsWith(item.href);

      return (
        <a
          href={item.href}
          class:list={[
            "transition-colors duration-fast ease-smooth hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent",
            isActive ? "text-accent" : "text-primary"
          ]}
          aria-current={isActive ? 'page' : undefined}
        >
          {item.label}
        </a>
      );
    })}
  </nav>

  <div class="col-span-2 hidden justify-self-end font-mono text-xs uppercase tracking-[var(--tracking-archive)] text-secondary md:col-span-1 md:block">
    {SITE_META.STATUS}
  </div>
</header>
