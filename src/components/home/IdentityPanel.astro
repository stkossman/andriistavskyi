---
import { Image } from 'astro:assets'
import portraitImage from '@/assets/images/personal/portrait.jpg'
import { HOME } from '@/const/home'
import { optionStateClass } from './classes'
---

<section
  class="hidden h-full overflow-y-auto pr-0 transition-[opacity,filter,transform] duration-200 lg:pr-3"
  aria-labelledby="identity-panel-title"
  data-identity-panel
  tabindex="-1"
>
  <div class="motion-panel-enter flex min-h-full items-center justify-center py-6">
    <article class="grid h-auto min-h-[42rem] w-[min(42rem,100%)] border border-black/15 bg-[#eef1ee] px-8 py-10 font-mono uppercase text-[var(--color-text)] sm:h-[min(82vh,47.5rem)] sm:min-h-[46rem] sm:px-16 sm:py-14 lg:w-[min(44rem,85%)]">
      <div class="flex justify-center">
        <img
          src="/logo.svg"
          alt=""
          class="h-14 w-14 object-contain opacity-85 sm:h-16 sm:w-16"
          aria-hidden="true"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="flex items-center justify-center py-16 sm:py-24">
        <Image
          src={portraitImage}
          alt={HOME.identity.portraitAlt}
          class="h-[150px] w-28 border border-black/10 object-cover object-center grayscale contrast-110 brightness-90 sm:h-44 sm:w-[132px]"
          widths={[112, 132, 264]}
          sizes="(min-width: 640px) 132px, 112px"
        />
      </div>

      <div class="mx-auto grid w-full max-w-md gap-6 text-[10px] leading-4 tracking-[0.03em] sm:text-[11px]">
        <div class="text-center text-[11px] font-semibold leading-5 tracking-[0.04em] sm:text-xs" id="identity-panel-title">
          {HOME.identity.title}
        </div>

        <dl class="grid gap-3">
          <div class="grid grid-cols-[6.75rem_minmax(0,1fr)] gap-4">
            <dt class="font-bold tracking-[0.04em]">{HOME.identity.job.label}</dt>
            <dd class="m-0 flex flex-wrap gap-x-2 gap-y-1">
              {HOME.identity.job.options.map((option) => (
                <span class={optionStateClass[option.state]}>{option.label}</span>
              ))}
            </dd>
          </div>

          <div class="grid grid-cols-[6.75rem_minmax(0,1fr)] gap-4">
            <dt class="font-bold tracking-[0.04em]">{HOME.identity.experience.label}</dt>
            <dd class="m-0 flex flex-wrap gap-x-3 gap-y-1">
              {HOME.identity.experience.options.map((option) => (
                <span class={optionStateClass[option.state]}>{option.label}</span>
              ))}
            </dd>
          </div>

          <div class="grid grid-cols-[6.75rem_minmax(0,1fr)] gap-4">
            <dt class="font-bold tracking-[0.04em]">{HOME.identity.issued.label}</dt>
            <dd class="m-0">{HOME.identity.issued.value}</dd>
          </div>

          <div class="grid grid-cols-[6.75rem_minmax(0,1fr)] gap-4">
            <dt class="font-bold tracking-[0.04em]">{HOME.identity.origin.label}</dt>
            <dd class="m-0">{HOME.identity.origin.value}</dd>
          </div>
        </dl>
      </div>

      <p class="m-0 mx-auto max-w-[34rem] self-end pt-16 text-center text-[10px] font-semibold leading-4 tracking-[0.03em] sm:pt-20 sm:text-[11px]">
        {HOME.identity.description}
      </p>
    </article>
  </div>
</section>
