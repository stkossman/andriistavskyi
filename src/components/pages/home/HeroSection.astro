---
import AnimatedLink from '@/components/common/AnimatedLink.astro'
import PageTitle from '@/components/common/PageTitle.astro'
---

<section class="grid grid-cols-1 xl:grid-cols-12 gap-12 xl:gap-16 items-start">
  <div class="xl:col-span-9 flex flex-col gap-6 pr-0 xl:pr-12">
    <PageTitle>
      Hello, I'm Andrii,<br />
      Developer. Please welcome to my <span class="italic font-light">digital</span> space.
    </PageTitle>
    
    <p class="max-w-3xl text-lg md:text-xl xl:text-2xl text-text-primary leading-normal font-medium mt-2 md:mt-4">
      Currently passing a .NET/React internship <AnimatedLink href="https://www.softserveinc.com/" text="@SoftServe" />, previously Team Lead & Frontend Developer intern, and studying Computer Science at <AnimatedLink href="https://www.oa.edu.ua/" text="@OstrohAcademy" />.
    </p>
  </div>

  <div class="xl:col-span-3 flex justify-start xl:justify-end pt-4 xl:pt-6">
    <a href="https://www.softserveinc.com/" target="_blank" rel="noopener noreferrer" class="inline-block opacity-60 hover:opacity-100 transition-opacity duration-normal grayscale hover:grayscale-0">
      <img 
        src="https://www.softserveinc.com/cdn/img/root/logo-root.svg" 
        alt="SoftServe" 
        class="h-4 md:h-6 w-auto invert"
      />
    </a>
  </div>
</section>