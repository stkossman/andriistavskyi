---
import { LICENSES_TEXT, PACKAGE_LICENSES } from '@/const/licenses'
import { SITE } from '@/const/site'
import Layout from '@/layouts/Layout.astro'
---

<Layout title={`${LICENSES_TEXT.packages.title} - ${SITE.name}`} description="Package license references for andrii stavskyi.">
  <section class="mx-auto min-h-dvh w-full max-w-4xl px-6 py-8 text-sm leading-6 lg:px-10 lg:py-9" aria-labelledby="package-licenses-title">
    <a class="font-[var(--font-mono)] text-xs underline decoration-[var(--color-subtle)]" href="/">
      {LICENSES_TEXT.packages.backLabel}
    </a>

    <header class="mt-14 grid gap-4">
      <p class="m-0 font-[var(--font-mono)] text-xs text-[var(--color-muted)]">
        {LICENSES_TEXT.packages.eyebrow}
      </p>
      <h1 id="package-licenses-title" class="m-0 text-2xl font-normal tracking-normal">
        {LICENSES_TEXT.packages.title}
      </h1>
      <p class="m-0 max-w-xl text-[0.8125rem] leading-6 text-[var(--color-muted)]">
        {LICENSES_TEXT.packages.description}
      </p>
    </header>

    <div class="mt-12 grid gap-6">
      {PACKAGE_LICENSES.map((item) => (
        <article class="border-t border-[var(--color-border)] pt-5">
          <h2 class="m-0 text-base font-normal">{item.name}</h2>
          <dl class="mt-4 grid gap-2 text-[0.8125rem] text-[var(--color-muted)]">
            <div>
              <dt class="font-[var(--font-mono)] text-xs text-[var(--color-text)]">{LICENSES_TEXT.labels.package}</dt>
              <dd class="m-0">{item.packageName}</dd>
            </div>
            <div>
              <dt class="font-[var(--font-mono)] text-xs text-[var(--color-text)]">{LICENSES_TEXT.labels.license}</dt>
              <dd class="m-0">{item.license}</dd>
            </div>
            <div>
              <dt class="font-[var(--font-mono)] text-xs text-[var(--color-text)]">{LICENSES_TEXT.labels.source}</dt>
              <dd class="m-0">
                <a class="underline decoration-[var(--color-subtle)]" href={item.href}>{item.source}</a>
              </dd>
            </div>
          </dl>
        </article>
      ))}
    </div>
  </section>
</Layout>
