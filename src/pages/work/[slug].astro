---
import { Image } from 'astro:assets'
import { PROJECTS, type Project } from '@/const/projects'
import { SITE } from '@/const/site'
import Layout from '@/layouts/Layout.astro'

export function getStaticPaths() {
	return PROJECTS.map(project => ({
		params: { slug: project.slug },
		props: { project },
	}))
}

interface Props {
	project: Project
}

const { project } = Astro.props
---

<Layout title={`${project.title} - ${SITE.name}`} description={project.description}>
  <article class="project-page">
    <a class="back-link" href="/#work">Back to work</a>

    <header class="project-hero">
      <p class="section__eyebrow">{project.context}</p>
      <h1>{project.title}</h1>
      <p>{project.description}</p>
    </header>

    <Image
      src={project.image}
      alt={project.imageAlt}
      class="project-image"
      widths={[640, 960, 1280]}
      sizes="(min-width: 900px) 78vw, 100vw"
    />

    <dl class="project-details">
      <div>
        <dt>Role</dt>
        <dd>{project.role}</dd>
      </div>
      <div>
        <dt>Context</dt>
        <dd>{project.context}</dd>
      </div>
      <div>
        <dt>Year</dt>
        <dd>{project.year}</dd>
      </div>
      <div>
        <dt>Stack</dt>
        <dd>{project.stack.join(', ')}</dd>
      </div>
      <div>
        <dt>Focus</dt>
        <dd>{project.focus}</dd>
      </div>
      <div>
        <dt>Links</dt>
        <dd>
          {project.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </dd>
      </div>
    </dl>
  </article>
</Layout>
