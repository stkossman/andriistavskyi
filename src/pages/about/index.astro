---
import './about.scss'
import Breadcrumbs from '@/components/breadcrumbs/Breadcrumbs.astro'
import { EDUCATION } from '@/const/education'
import { EXPERIENCE } from '@/const/experience'
import { SITE } from '@/const/site'
import Layout from '@/layouts/Layout.astro'

const details = [
	['Location', 'Ukraine'],
	['Work', 'Software engineering'],
	['Focus', '.NET / web systems'],
	['Interests', 'Reading, writing, guitar, calisthenics'],
	['Languages', 'Ukrainian, English'],
] as const
---

<Layout
	title={`About - ${SITE.name}`}
	description="About andrii stavskyi, a Full-Stack Software Engineer from Ukraine."
>
	<div class="page-stack about-page">
		<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />

		<section class="section page-title-section" aria-labelledby="about-title">
			<header>
				<h1 id="about-title">About</h1>
			</header>
		</section>

		<section class="section" aria-labelledby="intro-title">
			<header><h2 id="intro-title">Intro</h2></header>
			<div class="prose">
				<p>
					I'm a Full-Stack Software Engineer from Ukraine working primarily with
					.NET and modern web technologies.
				</p>
				<p>
					I prefer software that is predictable, maintainable, and easy to
					reason about. Most of my attention goes to clear boundaries, practical
					interfaces, and code that can be changed without first being decoded.
				</p>
				<p>
					I work across backend and frontend development and tend to treat them
					as parts of the same system rather than separate disciplines.
				</p>
			</div>
		</section>

		<hr />

		<section class="section" aria-labelledby="experience-title">
			<header><h2 id="experience-title">Experience</h2></header>
			<ol class="experience-list">
				{EXPERIENCE.map(item => (
					<li class="experience-item">
						<div class="experience-item__heading">
							<h3>{item.company}</h3>
							<p class="experience-item__period">{item.period}</p>
						</div>
						<p class="experience-item__role">{item.role}</p>
						<div class="prose">
							<p>{item.description}</p>
							{item.details?.map(paragraph => <p>{paragraph}</p>)}
						</div>
						{item.keyWork && (
							<ul>
								{item.keyWork.map(work => <li>{work}</li>)}
							</ul>
						)}
						{item.note && <p class="muted">{item.note}</p>}
					</li>
				))}
			</ol>
		</section>

		<hr />

		<section class="section" aria-labelledby="education-title">
			<header><h2 id="education-title">Education</h2></header>
			<ol class="plain-list">
				{EDUCATION.map(item => (
					<li class="plain-item">
						<h3>{item.institution}</h3>
						<p class="muted">
							{item.program} · <span class="meta-value">{item.period}</span>
						</p>
					</li>
				))}
			</ol>
		</section>

		<hr />

		<section class="section" aria-labelledby="side-projects-title">
			<header><h2 id="side-projects-title">Side projects</h2></header>
			<div class="prose">
				<p>
					I usually start personal projects because there is either a small
					problem I want solved properly or an idea I want to understand by
					building it.
				</p>
				<p>
					I prefer focused applications with a clear purpose over projects
					created only to demonstrate a technology stack. Soliloquy is the
					clearest example of that approach.
				</p>
				<p><a href="/work/">View selected work</a></p>
			</div>
		</section>

		<hr />

		<section class="section" aria-labelledby="outside-software-title">
			<header><h2 id="outside-software-title">Outside software</h2></header>
			<div class="prose">
				<p>
					Outside software, I spend time reading and writing, playing guitar,
					and training calisthenics.
				</p>
				<p>
					Most of these are deliberately offline activities - a useful
					counterweight to work that is otherwise spent almost entirely in front
					of a screen.
				</p>
			</div>
		</section>

		<hr />

		<section class="section" aria-labelledby="details-title">
			<header><h2 id="details-title">Details</h2></header>
			<table class="details-table">
				<tbody>
					{details.map(([label, value]) => (
						<tr>
							<th scope="row">{label}</th>
							<td>{value}</td>
						</tr>
					))}
				</tbody>
			</table>
		</section>
	</div>
</Layout>
