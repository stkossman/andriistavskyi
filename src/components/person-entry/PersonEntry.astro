---
import './PersonEntry.scss'
import { PEOPLE_PAGE } from '@/const/pages/people'
import type { Person } from '@/const/people'

interface Props {
	person: Person
	index: number
}

const { person, index } = Astro.props
const personNumber = String(index + 1).padStart(2, '0')
const profileLabel = `${person.name} on ${person.profile.label}`
---

<article class="person-entry">
	<header class="person-entry__header">
		<h3>
			<span class="person-entry__number">{personNumber} / </span>
			{person.name}
		</h3>
		<p class="person-entry__role">{person.role}</p>
	</header>

	<div class="person-entry__body prose">
		<p>{person.context}</p>
	</div>

	<section class="person-entry__section" aria-labelledby={`person-note-${index}`}>
		<h4 id={`person-note-${index}`}>My Note</h4>
		<p>{person.note}</p>
	</section>

	{person.notableWork && (
		<section class="person-entry__section" aria-labelledby={`person-work-${index}`}>
			<h4 id={`person-work-${index}`}>{PEOPLE_PAGE.labels.notableWork}</h4>
			<ul class="plain-list">
				{person.notableWork.map(work => (
					<li class="plain-item">
						<a href={work.url} aria-label={`${work.label} by ${person.name}`}>
							{work.label}
						</a>
					</li>
				))}
			</ul>
		</section>
	)}

	<section class="person-entry__section" aria-labelledby={`person-profile-${index}`}>
		<h4 id={`person-profile-${index}`}>{PEOPLE_PAGE.labels.profile}</h4>
		<p><a href={person.profile.url} aria-label={profileLabel}>{person.profile.label}</a></p>
	</section>
</article>
