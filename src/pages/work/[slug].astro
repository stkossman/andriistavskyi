---
import './project-detail.scss'
import { Image } from 'astro:assets'
import Breadcrumbs from '@/components/breadcrumbs/Breadcrumbs.astro'
import ProjectMetadata from '@/components/project-metadata/ProjectMetadata.astro'
import { WORK_PAGE } from '@/const/pages/work'
import { PROJECT_DETAIL_LABELS, PROJECTS, type Project } from '@/const/projects'
import { SITE } from '@/const/site'
import Layout from '@/layouts/Layout.astro'

export function getStaticPaths() {
	return PROJECTS.map(project => ({
		params: { slug: project.slug },
		props: { project },
	}))
}

interface Props {
	project: Project
}

const { project } = Astro.props
const description = project.homepageSummary[0]

function getSectionId(title: string, id?: string) {
	return id ?? title.toLowerCase().replaceAll(' ', '-')
}
---

<Layout title={`${project.title} - ${SITE.name}`} description={description}>
	<article class="project-page">
		<Breadcrumbs
			items={[
				...WORK_PAGE.breadcrumbs,
				{ label: project.title },
			]}
		/>

		<header class="project-page__header page-title-block">
			<h1>{project.title}</h1>
			<p class="section-note">{project.context}</p>
			<p>{description}</p>
		</header>

		<ProjectMetadata items={project.metadata} />

		<figure class="project-page__media">
			<Image
				src={project.image}
				alt={project.imageAlt}
				widths={[640, 900, 1200]}
				sizes="(min-width: 920px) 900px, calc(100vw - 32px)"
			/>
			<figcaption>{project.imageAlt}</figcaption>
		</figure>

		{project.onThisPage && (
			<nav class="section on-this-page" aria-labelledby="on-this-page-title">
				<header>
					<h2 id="on-this-page-title">{PROJECT_DETAIL_LABELS.onThisPage}</h2>
				</header>
				<ul>
					{project.onThisPage.map(item => (
						<li><a href={item.href}>{item.label}</a></li>
					))}
				</ul>
			</nav>
		)}

		{project.caseStudySections.map(section => (
			<section
				id={getSectionId(section.title, section.id)}
				class="section"
				aria-labelledby={`${getSectionId(section.title, section.id)}-title`}
			>
				<header>
					<h2 id={`${getSectionId(section.title, section.id)}-title`}>
						{section.title}
					</h2>
				</header>
				<div class="prose">
					{section.body?.map(paragraph => <p>{paragraph}</p>)}
					{section.list && (
						<>
							{section.list.title && <h3>{section.list.title}</h3>}
							<ul>
								{section.list.items.map(item => <li>{item}</li>)}
							</ul>
						</>
					)}
					{section.lists?.map(list => (
						<div class="case-list-group">
							{list.title && <h3>{list.title}</h3>}
							<ul>
								{list.items.map(item => <li>{item}</li>)}
							</ul>
						</div>
					))}
					{section.subsections?.map(subsection => (
						<section class="case-subsection" aria-label={subsection.title}>
							<h3>{subsection.title}</h3>
							{subsection.body.map(paragraph => <p>{paragraph}</p>)}
						</section>
					))}
					{section.flow && <pre class="project-flow">{section.flow}</pre>}
				</div>
			</section>
		))}

		<section id="links" class="section" aria-labelledby="links-title">
			<header>
				<h2 id="links-title">{PROJECT_DETAIL_LABELS.links}</h2>
			</header>
			<ul class="project-page__links">
				{project.links.map(link => (
					<li><a href={link.href}>{link.label}</a></li>
				))}
			</ul>
		</section>
	</article>
</Layout>
