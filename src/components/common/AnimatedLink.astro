---
type IconComponent = (props: {
	class?: string
	'aria-hidden'?: string | boolean
}) => unknown

interface Props {
	href: string
	text: string
	icon?: IconComponent
}

const { href, text, icon: Icon } = Astro.props
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="group inline-flex w-fit max-w-full items-center gap-1 text-primary transition-colors duration-normal ease-smooth hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
>
  <span class="inline bg-linear-to-r from-current to-current bg-[length:100%_1px] bg-left-bottom bg-no-repeat transition-[background-size,color] duration-normal ease-smooth group-hover:bg-[length:0_1px]">
    {text}
  </span>
  {Icon && <Icon class="h-4 w-4 shrink-0 text-current transition-transform duration-normal ease-smooth group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />}
</a>

