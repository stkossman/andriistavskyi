---
import { render } from 'astro:content'
import { HOME } from '@/const/home'
import { SITE } from '@/const/site'
import Layout from '@/layouts/Layout.astro'
import { type Entry, formatEntryDate, getPublishedEntries } from '@/lib/entries'

export async function getStaticPaths() {
	const entries = await getPublishedEntries()

	return entries.map(entry => ({
		params: { slug: entry.id },
		props: { entry },
	}))
}

interface Props {
	entry: Entry
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<Layout title={`${entry.data.title} - ${SITE.name}`} description={entry.data.summary}>
  <article class="mx-auto min-h-dvh w-full max-w-[72ch] px-6 py-8 text-[15px] leading-7 lg:px-10 lg:py-9">
    <a class="inline-flex rounded-[2px] px-1.5 py-0.5 font-mono text-[13px] underline decoration-[var(--color-subtle)] transition-colors duration-200 hover:bg-[var(--color-hover)] hover:text-[var(--color-text)] focus-visible:bg-[var(--color-hover)] focus-visible:text-[var(--color-text)]" href="/entries">
      {HOME.entries.backLabel}
    </a>

    <header class="motion-index-enter mt-10 grid gap-3">
      <time class="font-mono text-[12px] text-[var(--color-muted)]" datetime={entry.data.date.toISOString()}>
        {formatEntryDate(entry.data.date)}
      </time>
      <h1 class="m-0 text-3xl font-medium leading-tight tracking-normal sm:text-4xl">
        {entry.data.title}
      </h1>
    </header>

    <div class="entry-prose motion-index-enter mt-10" style="--motion-delay: 120ms">
      <Content />
    </div>
  </article>
</Layout>
