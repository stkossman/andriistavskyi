---
import { Image } from 'astro:assets'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import ProjectMetadata from '@/components/ProjectMetadata.astro'
import { PROJECTS, type Project } from '@/const/projects'
import { SITE } from '@/const/site'
import Layout from '@/layouts/Layout.astro'

export function getStaticPaths() {
	return PROJECTS.map(project => ({
		params: { slug: project.slug },
		props: { project },
	}))
}

interface Props {
	project: Project
}

const { project } = Astro.props
const description = project.homepageSummary[0]
---

<Layout title={`${project.title} - ${SITE.name}`} description={description}>
	<article class="project-page">
		<Breadcrumbs
			items={[
				{ label: 'Home', href: '/' },
				{ label: 'Work', href: '/work/' },
				{ label: project.title },
			]}
		/>

		<header class="project-page__header">
			<h1>{project.title}</h1>
			<p class="section-note">{project.context}</p>
			<p>{description}</p>
		</header>

		<ProjectMetadata items={project.metadata} />

		<figure class="project-page__media">
			<Image
				src={project.image}
				alt={project.imageAlt}
				widths={[640, 900, 1200]}
				sizes="(min-width: 920px) 900px, calc(100vw - 32px)"
			/>
			<figcaption>{project.imageAlt}</figcaption>
		</figure>

		<hr />

		<section class="section" aria-labelledby="overview-title">
			<header>
				<h2 id="overview-title">Overview</h2>
			</header>
			<div class="prose">
				{project.overview.map(paragraph => <p>{paragraph}</p>)}
			</div>
		</section>

		{project.roleDescription && (
			<>
				<hr />
				<section class="section" aria-labelledby="role-title">
					<header>
						<h2 id="role-title">My role</h2>
					</header>
					<div class="prose">
						{project.roleDescription.map(paragraph => <p>{paragraph}</p>)}
					</div>
				</section>
			</>
		)}

		{project.technicalWork?.map(section => (
			<>
				<hr />
				<section class="section" aria-labelledby={`${section.title.toLowerCase().replaceAll(' ', '-')}-title`}>
					<header>
						<h2 id={`${section.title.toLowerCase().replaceAll(' ', '-')}-title`}>
							{section.title}
						</h2>
					</header>
					<div class="prose">
						{section.body.map(paragraph => <p>{paragraph}</p>)}
					</div>
				</section>
			</>
		))}

		{project.caseStudySections?.map(section => (
			<>
				<hr />
				<section class="section" aria-labelledby={`${section.title.toLowerCase().replaceAll(' ', '-')}-title`}>
					<header>
						<h2 id={`${section.title.toLowerCase().replaceAll(' ', '-')}-title`}>
							{section.title}
						</h2>
					</header>
					<div class="prose">
						{section.body.map(paragraph => <p>{paragraph}</p>)}
					</div>
				</section>
			</>
		))}

		<hr />

		<section class="section" aria-labelledby="links-title">
			<header>
				<h2 id="links-title">Links</h2>
			</header>
			<ul class="link-list">
				{project.links.map(link => (
					<li><a href={link.href}>{link.label}</a></li>
				))}
			</ul>
		</section>
	</article>
</Layout>
