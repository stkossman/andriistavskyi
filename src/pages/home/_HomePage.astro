---
import './HomePage.scss'
import ProjectSummary from '@/components/project-summary/ProjectSummary.astro'
import { HOME_PAGE } from '@/const/pages/home'
import { PROJECTS } from '@/const/projects'
import { SITE } from '@/const/site'
import Layout from '@/layouts/Layout.astro'

function resolveHref(href?: string) {
	return href === 'softServeHref' ? SITE.softServeHref : href
}
---

<Layout title={SITE.title} description={SITE.description}>
	<div class="page-stack">
		<section class="intro" aria-labelledby="intro-title">
			<h1 id="intro-title">{HOME_PAGE.title}</h1>
			<dl class="intro__meta-table" aria-label={HOME_PAGE.identityLabel}>
				{HOME_PAGE.identity.map(item => (
					<div>
						<dt>{item.label}</dt>
						<dd>
							{'href' in item ? (
								<a href={resolveHref(item.href)}>{item.value}</a>
							) : (
								item.value
							)}
						</dd>
					</div>
				))}
			</dl>
			<p>{HOME_PAGE.intro}</p>
		</section>

		<hr />

		<section class="section" aria-labelledby="work-title">
			<header>
				<h2 id="work-title">{HOME_PAGE.selectedWorkTitle}</h2>
			</header>
			<div class="project-list">
				{PROJECTS.map((project, index) => <ProjectSummary project={project} index={index} />)}
			</div>
		</section>

		<hr />

		<section class="section" aria-labelledby="about-preview-title">
			<header>
				<h2 id="about-preview-title">{HOME_PAGE.aboutPreview.title}</h2>
			</header>
			<div class="prose">
				{HOME_PAGE.aboutPreview.paragraphs.map(paragraph => <p>{paragraph}</p>)}
				<p>
					<a href={HOME_PAGE.aboutPreview.link.href}>{HOME_PAGE.aboutPreview.link.label}</a>
				</p>
			</div>
		</section>
	</div>
</Layout>
