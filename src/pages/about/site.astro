---
import '../about/about.scss'
import AboutNav from '@/components/about-nav/AboutNav.astro'
import Breadcrumbs from '@/components/breadcrumbs/Breadcrumbs.astro'
import { ABOUT_SITE_PAGE } from '@/const/pages/about-site'
import { SITE } from '@/const/site'
import Layout from '@/layouts/Layout.astro'
---

<Layout
	title={`${ABOUT_SITE_PAGE.title} - ${SITE.name}`}
	description={ABOUT_SITE_PAGE.description}
>
	<div class="page-stack about-page">
		<Breadcrumbs items={ABOUT_SITE_PAGE.breadcrumbs} />
		<AboutNav />

		<section class="section page-title-section" aria-labelledby="about-site-title">
			<header>
				<h1 id="about-site-title">{ABOUT_SITE_PAGE.title}</h1>
			</header>
		</section>

		{ABOUT_SITE_PAGE.sections.map(section => (
			<section class="section" aria-labelledby={`${section.title.toLowerCase().replaceAll(' ', '-')}-title`}>
				<header>
					<h2 id={`${section.title.toLowerCase().replaceAll(' ', '-')}-title`}>
						{section.title}
					</h2>
				</header>
				<div class="prose">
					{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
				</div>
			</section>
		))}
	</div>
</Layout>
