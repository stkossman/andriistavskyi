---
import { HOME } from '@/const/home'
import { SITE } from '@/const/site'
import { type Entry, formatEntryDate, formatEntryNumber } from '@/lib/entries'
import Layout from './Layout.astro'

interface Props {
	entry: Entry
}

const { entry } = Astro.props
---

<Layout title={`${entry.data.title} - ${SITE.name}`} description={entry.data.summary}>
  <article class="mx-auto min-h-dvh w-full max-w-[88rem] px-6 py-8 text-[15px] leading-7 lg:px-10 lg:py-9">
    <a class="inline-flex rounded-[2px] px-1.5 py-0.5 font-mono text-[13px] underline decoration-[var(--color-subtle)] transition-colors duration-200 hover:bg-[var(--color-hover)] hover:text-[var(--color-text)] focus-visible:bg-[var(--color-hover)] focus-visible:text-[var(--color-text)]" href="/#entries-title" aria-label="Back to entries on home">
      {HOME.entries.backLabel}
    </a>

    <div class="mt-10 grid gap-8 md:grid-cols-[minmax(8rem,12rem)_minmax(0,64ch)] md:gap-12">
      <aside class="motion-index-enter grid content-start gap-1 font-mono text-[12px] uppercase leading-5 text-[var(--color-muted)] md:sticky md:top-8 md:self-start" aria-label="Entry metadata">
        <p class="m-0">ENTRY {formatEntryNumber(entry.data.number)}</p>
        <time datetime={entry.data.date.toISOString()}>{formatEntryDate(entry.data.date)}</time>
      </aside>

      <div class="min-w-0">
        <header class="motion-index-enter grid gap-3" style="--motion-delay: 80ms">
          <h1 class="m-0 text-3xl font-medium leading-tight tracking-normal sm:text-4xl">
            {entry.data.title}
          </h1>
        </header>

        <div class="entry-content motion-index-enter mt-8" style="--motion-delay: 140ms">
          <slot />
        </div>
      </div>
    </div>
  </article>
</Layout>
