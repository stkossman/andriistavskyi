---
import './SiteHeader.scss'
import { CONTACT_LINKS } from '@/const/contact'
import { PRIMARY_NAV_LINKS, SITE, SITE_UI } from '@/const/site'

const currentPath = Astro.url.pathname

function isCurrent(href: string) {
	if (href === '/') {
		return currentPath === '/'
	}

	return currentPath.startsWith(href)
}
---

<header class="site-header">
	<div class="site-header__masthead">
		<a class="site-header__name" href="/">{SITE.lowercaseName}</a>
		<div class="site-header__gradient" aria-hidden="true"></div>
	</div>
	<div class="site-header__nav-row">
		<nav class="site-header__nav" aria-label={SITE_UI.primaryNavLabel}>
			{PRIMARY_NAV_LINKS.map(link => (
				<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
					{link.label}
				</a>
			))}
		</nav>

		<nav class="site-header__nav site-header__nav--external" aria-label={SITE_UI.externalNavLabel}>
			{CONTACT_LINKS.map(link => (
				<a href={link.href}>{link.label}</a>
			))}
		</nav>
	</div>
</header>
