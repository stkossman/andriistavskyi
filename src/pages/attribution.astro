---
import Breadcrumbs from '@/components/breadcrumbs/Breadcrumbs.astro'
import { ATTRIBUTION_PAGE } from '@/const/pages/attribution'
import { SITE } from '@/const/site'
import Layout from '@/layouts/Layout.astro'
---

<Layout
	title={`${ATTRIBUTION_PAGE.title} - ${SITE.name}`}
	description={ATTRIBUTION_PAGE.description}
>
	<div class="page-stack">
		<Breadcrumbs items={ATTRIBUTION_PAGE.breadcrumbs} />

		<section class="section page-title-section" aria-labelledby="attribution-title">
			<header>
				<h1 id="attribution-title">{ATTRIBUTION_PAGE.title}</h1>
			</header>
		</section>

		{ATTRIBUTION_PAGE.sections.map(section => (
			<>
				<section class="section" aria-labelledby={`${section.title.toLowerCase().replaceAll(' ', '-')}-title`}>
					<header>
						<h2 id={`${section.title.toLowerCase().replaceAll(' ', '-')}-title`}>
							{section.title}
						</h2>
					</header>
					<div class="prose">
						{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
					</div>
				</section>
			</>
		))}
	</div>
</Layout>
