---
import AnimatedLink from '@/components/common/AnimatedLink.astro'
import { COMMON_TEXT } from '@/const/common'
---

<footer class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 border-t border-border/80 py-7 px-[var(--site-page-padding)] w-full mt-auto text-sm font-mono">
  <div class="flex flex-wrap items-center gap-1.5 text-secondary">
    <span>{COMMON_TEXT.FOOTER.TYPEFACE}</span>
    <AnimatedLink href="https://fontsource.org/fonts/unbounded" text="Unbounded" />
    <span class="px-0.5">&</span>
    <AnimatedLink href="https://fontsource.org/fonts/arimo" text="Arimo" />
    <span class="px-0.5">&</span>
    <AnimatedLink href="https://fontsource.org/fonts/shippori-mincho" text="Shippori Mincho" />
    <span class="px-0.5">&</span>
    <AnimatedLink href="https://fontsource.org/fonts/space-mono" text="Space Mono" />
  </div>

  <p class="text-xs uppercase tracking-[var(--tracking-archive)] text-secondary">
    {COMMON_TEXT.FOOTER.BUILT_WITH}
  </p>
</footer>
