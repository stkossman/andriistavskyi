---
import './HomePage.scss'
import ProjectSummary from '@/components/project-summary/ProjectSummary.astro'
import { PROJECTS } from '@/const/projects'
import { SITE } from '@/const/site'
import Layout from '@/layouts/Layout.astro'
---

<Layout title={SITE.title} description={SITE.description}>
	<div class="page-stack">
		<section class="intro" aria-labelledby="intro-title">
			<h1 id="intro-title">andrii stavskyi</h1>
			<dl class="intro__meta-table" aria-label="Identity details">
				<div>
					<dt>Role</dt>
					<dd>Full-Stack Software Engineer</dd>
				</div>
				<div>
					<dt>Currently</dt>
					<dd><a href={SITE.softServeHref}>SoftServe</a></dd>
				</div>
				<div>
					<dt>Location</dt>
					<dd>Ukraine</dd>
				</div>
			</dl>
			<p>
				I build web applications and software systems with an emphasis on clear
				behavior, maintainable code, and practical interfaces.
			</p>
		</section>

		<hr />

		<section class="section" aria-labelledby="work-title">
			<header>
				<h2 id="work-title">Selected Work</h2>
			</header>
			<div class="project-list">
				{PROJECTS.map((project, index) => <ProjectSummary project={project} index={index} />)}
			</div>
		</section>

		<hr />

		<section class="section" aria-labelledby="about-preview-title">
			<header>
				<h2 id="about-preview-title">About</h2>
			</header>
			<div class="prose">
				<p>
					I'm a Full-Stack Software Engineer working primarily with .NET and
					modern web technologies. I care about maintainable systems, clear
					boundaries, and interfaces that stay predictable as products grow.
				</p>
				<p>
					Outside software, I spend time reading, writing, playing guitar, and
					training calisthenics.
				</p>
				<p><a href="/about/">About</a></p>
			</div>
		</section>
	</div>
</Layout>
