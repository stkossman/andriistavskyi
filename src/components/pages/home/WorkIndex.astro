---
import { Image } from 'astro:assets'
import { PROJECTS, WORK_SECTION } from '@/const/projects'
---

<section class="section work-index" id="work" aria-labelledby="work-title">
  <div class="section__intro work-index__nav">
    <p class="section__eyebrow">
      <span>{WORK_SECTION.accent}</span>
      <span>{WORK_SECTION.label}</span>
    </p>
    <h2 id="work-title">{WORK_SECTION.label}</h2>
    <p>{WORK_SECTION.description}</p>

    <nav class="work-index__links" aria-label="Project list">
      {PROJECTS.map((project, index) => (
        <a
          href={`#work-${project.slug}`}
          class:list={['work-index__link', index === 0 && 'is-active']}
          data-work-link={project.slug}
        >
          <span>{project.title}</span>
          <small>{project.year}</small>
        </a>
      ))}
    </nav>
  </div>

  <div class="work-index__previews" data-work-previews>
    {PROJECTS.map((project) => (
      <article
        class="work-preview"
        id={`work-${project.slug}`}
        data-work-preview={project.slug}
        tabindex="-1"
      >
        <a class="work-preview__image-link" href={`/work/${project.slug}`} aria-label={`Open ${project.title}`}>
          <Image
            src={project.image}
            alt={project.imageAlt}
            class="work-preview__image"
            widths={[480, 768, 1120]}
            sizes="(min-width: 900px) 55vw, 100vw"
          />
        </a>

        <div class="work-preview__content">
          <div>
            <h3>
              <a href={`/work/${project.slug}`}>{project.title}</a>
            </h3>
            <p>{project.description}</p>
          </div>

          <dl class="work-preview__meta">
            <div>
              <dt>Role</dt>
              <dd>{project.role}</dd>
            </div>
            <div>
              <dt>Status</dt>
              <dd>{project.status} · {project.year}</dd>
            </div>
            <div>
              <dt>Stack</dt>
              <dd>{project.stack.join(', ')}</dd>
            </div>
          </dl>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  const previews = Array.from(document.querySelectorAll<HTMLElement>('[data-work-preview]'))
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-work-link]'))

  const setActiveProject = (slug: string) => {
    for (const link of links) {
      link.classList.toggle('is-active', link.dataset.workLink === slug)
      link.setAttribute('aria-current', link.dataset.workLink === slug ? 'true' : 'false')
    }
  }

  for (const link of links) {
    link.addEventListener('click', () => {
      const slug = link.dataset.workLink
      if (slug) {
        setActiveProject(slug)
      }
    })
  }

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visibleEntry = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]

        const slug = visibleEntry?.target.getAttribute('data-work-preview')
        if (slug) {
          setActiveProject(slug)
        }
      },
      {
        root: document.querySelector('[data-work-previews]'),
        threshold: [0.35, 0.6, 0.85],
      },
    )

    for (const preview of previews) {
      observer.observe(preview)
    }
  }
</script>
