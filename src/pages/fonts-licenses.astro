---
import { FONT_LICENSES, LICENSES_TEXT } from '@/const/licenses'
import { SITE } from '@/const/site'
import Layout from '@/layouts/Layout.astro'
---

<Layout title={`${LICENSES_TEXT.fonts.title} - ${SITE.name}`} description="Font package license information for andrii stavskyi.">
  <section class="mx-auto min-h-dvh w-full max-w-4xl px-6 py-8 text-[14px] leading-6 lg:px-10 lg:py-9" aria-labelledby="font-licenses-title">
    <a class="inline-flex rounded-[2px] px-1.5 py-0.5 font-[var(--font-mono)] text-[13px] underline decoration-[var(--color-subtle)] transition-colors duration-200 hover:bg-[var(--color-hover)] hover:text-[var(--color-text)] focus-visible:bg-[var(--color-hover)] focus-visible:text-[var(--color-text)]" href="/">
      {LICENSES_TEXT.fonts.backLabel}
    </a>

    <header class="motion-index-enter mt-10 grid gap-2">
      <h1 id="font-licenses-title" class="m-0 text-xl font-normal tracking-normal">
        {LICENSES_TEXT.fonts.title}
      </h1>
      <p class="m-0 max-w-xl text-[14px] leading-6 text-[var(--color-muted)]">
        {LICENSES_TEXT.fonts.description}
      </p>
    </header>

    <div class="motion-index-enter mt-8 overflow-x-auto" style="--motion-delay: 120ms">
      <table class="w-full min-w-[42rem] border-collapse text-left text-[13px] leading-6">
        <thead class="border-b border-[var(--color-border)] font-[var(--font-mono)] text-[12px] font-normal text-[var(--color-muted)]">
          <tr>
            <th class="py-2 pr-5 font-normal">{LICENSES_TEXT.labels.font}</th>
            <th class="py-2 pr-5 font-normal">{LICENSES_TEXT.labels.package}</th>
            <th class="py-2 pr-5 font-normal">{LICENSES_TEXT.labels.license}</th>
            <th class="py-2 font-normal">{LICENSES_TEXT.labels.source}</th>
          </tr>
        </thead>
        <tbody>
          {FONT_LICENSES.map((font) => (
            <tr class="border-b border-[var(--color-border)] last:border-b-0">
              <th class="py-2.5 pr-5 font-normal text-[var(--color-text)]">{font.name}</th>
              <td class="py-2.5 pr-5 font-[var(--font-mono)] text-[12px] text-[var(--color-muted)]">{font.packageName}</td>
              <td class="py-2.5 pr-5 text-[var(--color-muted)]">{font.license}</td>
              <td class="py-2.5">
                <a class="inline-flex rounded-[2px] px-1.5 py-0.5 text-[var(--color-muted)] underline decoration-[var(--color-subtle)] transition-colors duration-200 hover:bg-[var(--color-hover)] hover:text-[var(--color-text)] focus-visible:bg-[var(--color-hover)] focus-visible:text-[var(--color-text)]" href={font.href}>{font.source}</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Layout>
