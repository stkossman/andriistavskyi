---
import '@fontsource-variable/unbounded'
import '@fontsource/arimo'
import '@fontsource/shippori-mincho/japanese-400.css'
import '@fontsource/space-mono'
import '../styles/global.css'

import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'
import Seo from '@/components/common/Seo.astro'
import Footer from '@/components/layout/Footer.astro'
import Header from '@/components/layout/Header.astro'

interface Props {
	title: string
	description?: string
	image?: string
}

const { title, description, image } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <Seo title={title} description={description} image={image} />
  </head>
  <body class="min-h-screen flex flex-col bg-basic text-primary font-body selection:bg-accent selection:text-basic">
    <Header />
    <main class="flex-grow flex flex-col w-full px-[var(--site-page-padding)]">
      <slot />
    </main>
    <Footer />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
