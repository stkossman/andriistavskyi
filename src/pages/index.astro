---
import './index.scss'
import ProjectSummary from '@/components/project-summary/ProjectSummary.astro'
import { EDUCATION } from '@/const/education'
import { EXPERIENCE } from '@/const/experience'
import { PROJECTS } from '@/const/projects'
import { SITE } from '@/const/site'
import Layout from '@/layouts/Layout.astro'
---

<Layout title={SITE.title} description={SITE.description}>
	<div class="page-stack">
		<section class="intro" aria-labelledby="intro-title">
			<h1 id="intro-title">andrii stavskyi</h1>
			<dl class="intro__meta-table" aria-label="Identity details">
				<div>
					<dt>Role</dt>
					<dd>Full-Stack Software Engineer</dd>
				</div>
			</dl>
			<p>
				I build web applications and software systems with an emphasis on clear
				behavior, maintainable code, and practical interfaces.
			</p>
			<dl class="intro__meta-table" aria-label="Current status">
				<div>
					<dt>Currently at</dt>
					<dd><a href={SITE.softServeHref}>SoftServe</a></dd>
				</div>
				<div>
					<dt>Based in</dt>
					<dd>Ukraine</dd>
				</div>
			</dl>
		</section>

		<hr />

		<section class="section" aria-labelledby="experience-title">
			<header>
				<h2 id="experience-title">Experience</h2>
			</header>
			<ol class="experience-list">
				{EXPERIENCE.map(item => (
					<li class="experience-item">
						<h3>{item.company}</h3>
						<div class="experience-item__meta">
							<p>{item.role}</p>
							<p>{item.period}</p>
						</div>
						<p>{item.description}</p>
						{item.note && <p class="muted">{item.note}</p>}
					</li>
				))}
			</ol>
		</section>

		<hr />

		<section class="section" aria-labelledby="work-title">
			<header>
				<h2 id="work-title">Selected Work</h2>
			</header>
			<div class="project-list">
				{PROJECTS.map(project => <ProjectSummary project={project} />)}
			</div>
		</section>

		<hr />

		<section class="section" aria-labelledby="education-title">
			<header>
				<h2 id="education-title">Education</h2>
			</header>
			<ol class="plain-list">
				{EDUCATION.map(item => (
					<li class="plain-item">
						<h3>{item.institution}</h3>
						<p class="muted">{item.program} · {item.period}</p>
					</li>
				))}
			</ol>
		</section>

		<hr />

		<section class="section" aria-labelledby="about-preview-title">
			<header>
				<h2 id="about-preview-title">About</h2>
			</header>
			<div class="prose">
				<p>
					Software engineering is the main part of my work, but not the only
					thing I spend time on.
				</p>
				<p>
					Outside it, I write, build side projects, read, train, and spend a lot
					of time thinking about why some systems and interfaces feel more
					deliberate than others.
				</p>
				<p><a href="/about/">About</a></p>
			</div>
		</section>
	</div>
</Layout>
