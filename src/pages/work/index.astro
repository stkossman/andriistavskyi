---
import Breadcrumbs from '@/components/breadcrumbs/Breadcrumbs.astro'
import ProjectSummary from '@/components/project-summary/ProjectSummary.astro'
import { WORK_PAGE } from '@/const/pages/work'
import { PROJECTS } from '@/const/projects'
import { SITE } from '@/const/site'
import Layout from '@/layouts/Layout.astro'
---

<Layout
	title={`${WORK_PAGE.title} - ${SITE.name}`}
	description={WORK_PAGE.description}
>
	<div class="page-stack">
		<Breadcrumbs items={WORK_PAGE.breadcrumbs} />

		<section class="section page-title-section" aria-labelledby="work-title">
			<header>
				<h1 id="work-title">{WORK_PAGE.title}</h1>
				<p class="section-note">{WORK_PAGE.note}</p>
			</header>
			<div class="prose">
				{WORK_PAGE.paragraphs.map(paragraph => <p>{paragraph}</p>)}
			</div>
		</section>

		<section class="section" aria-label={WORK_PAGE.projectDirectoryLabel}>
			<div class="project-list">
				{PROJECTS.map((project, index) => (
					<ProjectSummary project={project} showRole index={index} />
				))}
			</div>
		</section>
	</div>
</Layout>
