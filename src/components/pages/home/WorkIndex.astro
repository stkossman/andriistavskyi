---
import { Image } from 'astro:assets'
import { HOME } from '@/const/home'
import { PROJECTS } from '@/const/projects'
---

<aside
  class="relative min-h-[18rem] border-t border-[var(--color-border)] pt-8 lg:h-full lg:border-t-0 lg:pt-0"
  aria-label="Selected work previews"
>
  <p
    class="max-w-48 text-xs leading-5 text-[var(--color-subtle)] lg:absolute lg:left-0 lg:top-1/2 lg:-translate-y-1/2"
    data-work-placeholder
  >
    {HOME.work.placeholder}
  </p>

  <div
    class="hidden h-full overflow-y-auto pr-0 lg:pr-3"
    data-work-panel
    tabindex="-1"
  >
    <div class="grid gap-10 pb-10">
      {PROJECTS.map((project) => (
        <article
          class="scroll-mt-8 border-b border-[var(--color-border)] pb-10 last:border-b-0"
          id={`work-${project.slug}`}
          data-work-preview={project.slug}
          tabindex="-1"
        >
          <a
            class="block no-underline"
            href={`/work/${project.slug}`}
            aria-label={`Open ${project.title}`}
          >
            <Image
              src={project.image}
              alt={project.imageAlt}
              class="aspect-[16/10] w-full border border-[var(--color-border)] bg-[#f3f3f1] object-cover"
              widths={[480, 768, 1120]}
              sizes="(min-width: 1024px) 58vw, 100vw"
            />
          </a>

          <div class="mt-3 flex flex-col gap-1 text-xs leading-5 sm:flex-row sm:items-start sm:justify-between">
            <h3 class="m-0 font-normal">
              <a class="underline decoration-[var(--color-subtle)]" href={`/work/${project.slug}`}>
                {project.title}
              </a>
            </h3>
            <p class="m-0 max-w-sm text-[var(--color-muted)] sm:text-right">
              {project.role} · {project.year}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</aside>

<script>
  const previews = Array.from(document.querySelectorAll<HTMLElement>('[data-work-preview]'))
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-work-link]'))
  const panel = document.querySelector<HTMLElement>('[data-work-panel]')
  const placeholder = document.querySelector<HTMLElement>('[data-work-placeholder]')
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  const setActiveProject = (slug: string) => {
    for (const link of links) {
      const isActive = link.dataset.workLink === slug
      const marker = link.querySelector<HTMLElement>('[data-work-marker]')

      link.classList.toggle('text-[var(--color-text)]', isActive)
      link.classList.toggle('text-[var(--color-muted)]', !isActive)
      link.classList.toggle('bg-black/[0.035]', isActive)
      link.setAttribute('aria-current', isActive ? 'true' : 'false')

      if (marker) {
        marker.classList.toggle('opacity-100', isActive)
        marker.classList.toggle('opacity-0', !isActive)
      }
    }
  }

  const openPanel = () => {
    panel?.classList.remove('hidden')
    placeholder?.classList.add('hidden')
  }

  for (const link of links) {
    link.addEventListener('click', (event) => {
      const slug = link.dataset.workLink
      const preview = slug
        ? document.querySelector<HTMLElement>(`[data-work-preview="${slug}"]`)
        : null

      if (!slug || !preview || !panel) {
        return
      }

      event.preventDefault()
      openPanel()
      setActiveProject(slug)
      preview.scrollIntoView({
        block: 'start',
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
      })
      panel.focus({ preventScroll: true })
    })
  }

  if ('IntersectionObserver' in window && panel) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visibleEntry = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]

        const slug = visibleEntry?.target.getAttribute('data-work-preview')
        if (slug) {
          setActiveProject(slug)
        }
      },
      {
        root: panel,
        threshold: [0.35, 0.6, 0.85],
      },
    )

    for (const preview of previews) {
      observer.observe(preview)
    }
  }
</script>
