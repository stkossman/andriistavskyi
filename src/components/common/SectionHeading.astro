---
interface Props {
	eyebrow?: string
	title: string
	className?: string
}

const { eyebrow, title, className = '' } = Astro.props
---

<div class={`flex flex-col gap-3 ${className}`}>
  {eyebrow && (
    <p class="font-jp text-sm text-accent" lang="ja">
      {eyebrow}
    </p>
  )}
  <h2 class="max-w-4xl text-section font-heading font-semibold text-primary">
    {title}
  </h2>
</div>

