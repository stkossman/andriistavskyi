---
import RatioDivider from '@/components/common/RatioDivider.astro'
import { ERROR_TEXT } from '@/const/error'
---
// this is a div
<div class="relative w-full flex flex-col items-center justify-center z-10">
  
  <h1 class="text-[8rem] sm:text-[12rem] md:text-[16rem] leading-none font-heading font-black text-primary tracking-tighter select-none">
    {ERROR_TEXT.TITLE}
  </h1>
  
  <div class="w-full max-w-5xl text-border-strong opacity-60 mt-[-2rem] md:mt-[-4rem]">
    <RatioDivider />
  </div>

</div>