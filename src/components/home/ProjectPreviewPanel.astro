---
import { Image } from 'astro:assets'
import { PROJECTS } from '@/const/projects'
---

<div
  class="hidden h-full overflow-y-auto pr-0 transition-[opacity,filter,transform] duration-200 lg:pr-3"
  data-work-panel
  tabindex="-1"
>
  <div class="grid gap-10 pb-10" data-work-panel-content>
    {PROJECTS.map((project) => (
      <article
        class="scroll-mt-8 border-b border-[var(--color-border)] pb-10 last:border-b-0"
        id={`work-${project.slug}`}
        data-work-preview={project.slug}
        tabindex="-1"
      >
        <a
          class="block no-underline"
          href={`/work/${project.slug}`}
          aria-label={`Open ${project.title}`}
        >
          <Image
            src={project.image}
            alt={project.imageAlt}
            class="aspect-[16/10] w-full border border-[var(--color-border)] bg-[var(--color-hover)] object-cover transition-opacity duration-200 hover:opacity-95 focus-visible:opacity-95"
            widths={[480, 768, 1120]}
            sizes="(min-width: 1024px) 58vw, 100vw"
          />
        </a>

        <div class="mt-3 flex flex-col gap-1 text-[15px] leading-6 sm:flex-row sm:items-start sm:justify-between">
            <h3 class="m-0 font-medium">
            <a class="underline decoration-[var(--color-subtle)]" href={`/work/${project.slug}`}>
              {project.title}
            </a>
          </h3>
          <p class="m-0 max-w-sm text-[var(--color-muted)] sm:text-right">
            {project.role} · {project.year}
          </p>
        </div>
      </article>
    ))}
  </div>
</div>
