---
import { HOME } from '@/const/home'
import { SITE } from '@/const/site'
import { interactiveItemClass } from './classes'
---

<section class="motion-index-enter max-w-[34rem]" style="--motion-delay: 40ms" aria-labelledby="intro-title">
  <h1 id="intro-title" class="m-0 font-[var(--font-mono)] text-[13px] font-normal lowercase leading-5">
    {HOME.hero.name}
  </h1>
  <p class="mt-5 max-w-[33rem] text-[15px] leading-7 text-[var(--color-text)]">
    {HOME.hero.descriptionStart}
    <a class="underline decoration-[var(--color-subtle)]" href={SITE.softServeHref}>{HOME.hero.companyLabel}</a>
    {HOME.hero.descriptionEnd}
  </p>
  <div class="group/list mt-3 flex flex-wrap gap-1">
    <button
      class={interactiveItemClass}
      type="button"
      aria-pressed="false"
      data-background-trigger
    >
      {HOME.hero.backgroundAction}
    </button>
  </div>
</section>
