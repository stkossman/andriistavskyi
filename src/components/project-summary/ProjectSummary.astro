---
import './ProjectSummary.scss'
import type { Project } from '@/const/projects'

interface Props {
	project: Project
	showRole?: boolean
	index?: number
}

const { project, showRole = false, index } = Astro.props
const displayContext = project.context
	.replace(` · ${project.year}`, '')
	.replace(` / ${project.year}`, '')
const projectNumber =
	typeof index === 'number' ? String(index + 1).padStart(2, '0') : undefined
---

<article class="project-summary">
	<header class="project-summary__header">
		<h3>
			{projectNumber && <span class="project-summary__number">{projectNumber} / </span>}
			<a href={`/work/${project.slug}/`}>{project.title}</a>
		</h3>
		<div class="project-summary__stamp">
			<span class="project-summary__year">{project.year}</span>
			<span>{displayContext}</span>
			{showRole && <span>{project.role}</span>}
		</div>
	</header>

	<div class="project-summary__body">
		{project.homepageSummary.map(paragraph => <p>{paragraph}</p>)}
	</div>

	<dl class="project-summary__meta">
		<div>
			<dt>Stack</dt>
			<dd>{project.stack.join(', ')}</dd>
		</div>
	</dl>

	<p class="project-summary__links">
		<a href={`/work/${project.slug}/`}>Project details</a>
		{project.links.map(link => (
			<>
				{' '}
				<span aria-hidden="true">|</span>
				{' '}
				<a href={link.href}>{link.label}</a>
			</>
		))}
	</p>
</article>
