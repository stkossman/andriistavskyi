---
import { Image } from 'astro:assets'
import sunsetBirds from '@/assets/images/decor/archive-sunset-birds.png'
import ensoCircle from '@/assets/images/decor/ink-enso-circle.png'
import AnimatedLink from '@/components/common/AnimatedLink.astro'
import CtaLink from '@/components/common/CtaLink.astro'
import PageTitle from '@/components/common/PageTitle.astro'
import { HOME_TEXT } from '@/const/home'
---

<section class="relative isolate min-h-[68vh] overflow-hidden border-b border-border pb-12 pt-12 md:pb-16 md:pt-16 xl:min-h-[72vh]">
  <div class="pointer-events-none absolute inset-y-8 right-0 -z-10 hidden w-[44%] max-w-[34rem] overflow-hidden border border-border bg-subtle md:block">
    <Image
      src={sunsetBirds}
      alt=""
      aria-hidden="true"
      class="h-full w-full object-cover opacity-35 mix-blend-multiply grayscale"
    />
    <div class="absolute inset-0 bg-basic/45"></div>
  </div>

  <Image
    src={ensoCircle}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute -right-16 top-12 -z-10 hidden w-56 opacity-20 mix-blend-multiply md:block lg:w-72"
  />

  <div class="grid grid-cols-1 xl:grid-cols-12 gap-10 xl:gap-16 items-start">
    <div class="xl:col-span-9 flex flex-col gap-6 pr-0 xl:pr-12">
      <div class="flex flex-wrap items-center gap-3 font-mono text-xs uppercase tracking-[var(--tracking-archive)] text-secondary">
        <span>Record 001</span>
        <span class="h-px w-8 bg-border" aria-hidden="true"></span>
        <span class="font-jp text-accent" lang="ja">開発者</span>
        <span>Developer</span>
      </div>

      <PageTitle>
        {HOME_TEXT.HERO.GREETING}
        <br />
        <span class="font-light text-secondary">{HOME_TEXT.HERO.ROLE_START}</span>{' '}
        {HOME_TEXT.HERO.ROLE_MIDDLE}
        <br class="hidden sm:block" />
        {HOME_TEXT.HERO.ROLE_END}
      </PageTitle>
      
      <p class="max-w-3xl text-body-lg md:text-xl xl:text-2xl text-primary leading-relaxed font-medium mt-1 md:mt-3">
        {HOME_TEXT.HERO.DESC_START}<AnimatedLink href="https://www.softserveinc.com/" text="@SoftServe" />{HOME_TEXT.HERO.DESC_MIDDLE}
      </p>

      <div class="flex flex-wrap items-center gap-4 md:gap-5 pt-4 md:pt-6">
        <CtaLink href="/work" variant="primary">
          {HOME_TEXT.HERO.PRIMARY_CTA}
        </CtaLink>

        <CtaLink href="/resume" variant="secondary">
          {HOME_TEXT.HERO.SECONDARY_CTA}
        </CtaLink>
      </div>
    </div>

    <aside class="xl:col-span-3 flex flex-col items-start gap-5 border-l border-border pl-5 pt-0 xl:items-end xl:pl-8 xl:pt-6">
      <p class="max-w-56 font-mono text-xs uppercase tracking-[var(--tracking-archive)] text-secondary xl:text-right">
        Frontend-focused full-stack work with React, TypeScript, Astro, and .NET.
      </p>
      <a href="https://www.softserveinc.com/" target="_blank" rel="noopener noreferrer" class="inline-block opacity-55 grayscale transition-opacity duration-normal ease-smooth hover:opacity-90 hover:grayscale-0">
        <img 
          src="https://assets.softserveinc.com/images/assets/hero-icon.svg/Zz1jNzMxODY4ODE2M2YxMWYxOWYyYjJlZWQ2YmU0MmQzMg==" 
          alt="SoftServe" 
          class="h-10 w-auto invert md:h-12"
        />
      </a>
      <div class="grid h-16 w-16 place-items-center border border-accent text-center font-jp text-xl leading-none text-accent" lang="ja" aria-label="Developer seal">
        開発
      </div>
    </aside>
  </div>
</section>
