---
import { LICENSES_TEXT, STACK_ITEMS } from '@/const/licenses'
import { SITE } from '@/const/site'
import Layout from '@/layouts/Layout.astro'
---

<Layout title={`${LICENSES_TEXT.stack.title} - ${SITE.name}`} description="Technology stack for andrii stavskyi.">
  <section class="mx-auto min-h-dvh w-full max-w-4xl px-6 py-8 text-[14px] leading-6 lg:px-10 lg:py-9" aria-labelledby="stack-title">
    <a class="inline-flex rounded-[2px] px-1.5 py-0.5 font-[var(--font-mono)] text-[13px] underline decoration-[var(--color-subtle)] transition-colors duration-200 hover:bg-[var(--color-hover)] hover:text-[var(--color-text)] focus-visible:bg-[var(--color-hover)] focus-visible:text-[var(--color-text)]" href="/">
      {LICENSES_TEXT.stack.backLabel}
    </a>

    <header class="motion-index-enter mt-10 grid gap-2">
      <h1 id="stack-title" class="m-0 text-xl font-normal tracking-normal">
        {LICENSES_TEXT.stack.title}
      </h1>
      <p class="m-0 max-w-xl text-[14px] leading-6 text-[var(--color-muted)]">
        {LICENSES_TEXT.stack.description}
      </p>
    </header>

    <dl class="motion-index-enter mt-8 grid max-w-2xl gap-y-2 text-[14px] leading-6 sm:grid-cols-[10rem_minmax(0,1fr)]" style="--motion-delay: 120ms">
      {STACK_ITEMS.map((item) => (
        <>
          <dt class="font-normal text-[var(--color-text)]">{item.name}</dt>
          <dd class="m-0 text-[var(--color-muted)]">{item.role}</dd>
        </>
      ))}
    </dl>
  </section>
</Layout>
