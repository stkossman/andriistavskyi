---
import { CONTACT_LINKS } from '@/const/contact'
import { SITE } from '@/const/site'
---

<footer class="site-footer">
  <p>© 2026 {SITE.name}</p>

  <nav aria-label="Footer navigation">
    {CONTACT_LINKS.slice(0, 3).map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>
</footer>
