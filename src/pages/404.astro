---
import { NOT_FOUND_PAGE } from '@/const/pages/not-found'
import { SITE } from '@/const/site'
import Layout from '@/layouts/Layout.astro'
---

<Layout title={`${NOT_FOUND_PAGE.title} - ${SITE.name}`} description={NOT_FOUND_PAGE.description}>
	<section class="section" aria-labelledby="not-found-title">
		<header>
			<p class="muted">{NOT_FOUND_PAGE.status}</p>
			<h1 id="not-found-title">{NOT_FOUND_PAGE.title}</h1>
		</header>
		<p><a href={NOT_FOUND_PAGE.homeLink.href}>{NOT_FOUND_PAGE.homeLink.label}</a></p>
	</section>
</Layout>
