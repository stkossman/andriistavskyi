---
import { HOME } from '@/const/home'
import { PROJECTS } from '@/const/projects'
import { interactiveItemClass } from './classes'
---

<section class="motion-index-enter grid gap-3" style="--motion-delay: 130ms" aria-labelledby="work-title">
  <h2 id="work-title" class="m-0 font-mono text-[13px] font-normal leading-5 text-[var(--color-muted)]">
    {HOME.work.label}
  </h2>

  <nav class="group/list grid gap-1 pl-6 font-mono text-[14px] leading-6" aria-label="Project list">
    {PROJECTS.map((project) => (
      <button
        class:list={[interactiveItemClass, 'grid grid-cols-[0.75rem_minmax(0,1fr)]']}
        type="button"
        aria-pressed="false"
        data-work-link={project.slug}
      >
        <span class="opacity-0" aria-hidden="true" data-work-marker>/</span>
        <span>{project.title}</span>
      </button>
    ))}
  </nav>
</section>
