---
import Breadcrumbs from '@/components/breadcrumbs/Breadcrumbs.astro'
import { CONTACT_LINKS } from '@/const/contact'
import { PROJECTS } from '@/const/projects'
import { SITE } from '@/const/site'
import Layout from '@/layouts/Layout.astro'
---

<Layout title={`Site map - ${SITE.name}`} description="Human-facing site map for andrii stavskyi.">
	<div class="page-stack">
		<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Site map' }]} />

		<section class="section page-title-section" aria-labelledby="sitemap-title">
			<header>
				<h1 id="sitemap-title">Site map</h1>
			</header>
		</section>

		<hr />

		<section class="section" aria-labelledby="main-title">
			<header><h2 id="main-title">Main</h2></header>
			<ul>
				<li><a href="/">Home</a></li>
				<li><a href="/work/">Work</a></li>
				<li><a href="/about/">About</a></li>
			</ul>
		</section>

		<hr />

		<section class="section" aria-labelledby="work-links-title">
			<header><h2 id="work-links-title">Work</h2></header>
			<ul>
				{PROJECTS.map(project => (
					<li><a href={`/work/${project.slug}/`}>{project.title}</a></li>
				))}
			</ul>
		</section>

		<hr />

		<section class="section" aria-labelledby="external-title">
			<header><h2 id="external-title">External</h2></header>
			<ul>
				{CONTACT_LINKS.map(link => (
					<li><a href={link.href}>{link.label}</a></li>
				))}
			</ul>
		</section>
	</div>
</Layout>
