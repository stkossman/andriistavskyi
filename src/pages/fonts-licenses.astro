---
import { FONT_LICENSES, LICENSES_TEXT } from '@/const/licenses'
import { SITE } from '@/const/site'
import Layout from '@/layouts/Layout.astro'
---

<Layout title={`${LICENSES_TEXT.fonts.title} - ${SITE.name}`} description="Font package license information for andrii stavskyi.">
  <section class="mx-auto min-h-dvh w-full max-w-4xl px-6 py-8 text-[15px] leading-7 lg:px-10 lg:py-9" aria-labelledby="font-licenses-title">
    <a class="inline-flex rounded-[2px] px-1.5 py-0.5 font-[var(--font-mono)] text-[13px] underline decoration-[var(--color-subtle)] transition-colors duration-200 hover:bg-[var(--color-hover)] hover:text-[var(--color-text)] focus-visible:bg-[var(--color-hover)] focus-visible:text-[var(--color-text)]" href="/">
      {LICENSES_TEXT.fonts.backLabel}
    </a>

    <header class="motion-index-enter mt-14 grid gap-4">
      <p class="m-0 font-[var(--font-mono)] text-[13px] text-[var(--color-muted)]">
        {LICENSES_TEXT.fonts.eyebrow}
      </p>
      <h1 id="font-licenses-title" class="m-0 text-2xl font-normal tracking-normal">
        {LICENSES_TEXT.fonts.title}
      </h1>
      <p class="m-0 max-w-xl text-[15px] leading-7 text-[var(--color-muted)]">
        {LICENSES_TEXT.fonts.description}
      </p>
    </header>

    <div class="motion-index-enter mt-12 grid gap-6" style="--motion-delay: 120ms">
      {FONT_LICENSES.map((font) => (
        <article class="border-t border-[var(--color-border)] pt-5">
          <h2 class="m-0 text-base font-normal">{font.name}</h2>
          <dl class="mt-4 grid gap-2 text-[15px] leading-7 text-[var(--color-muted)]">
            <div>
              <dt class="font-[var(--font-mono)] text-[13px] text-[var(--color-text)]">{LICENSES_TEXT.labels.package}</dt>
              <dd class="m-0">{font.packageName}</dd>
            </div>
            <div>
              <dt class="font-[var(--font-mono)] text-[13px] text-[var(--color-text)]">{LICENSES_TEXT.labels.license}</dt>
              <dd class="m-0">{font.license}</dd>
            </div>
            <div>
              <dt class="font-[var(--font-mono)] text-[13px] text-[var(--color-text)]">{LICENSES_TEXT.labels.source}</dt>
              <dd class="m-0">
                <a class="inline-flex rounded-[2px] px-1.5 py-0.5 underline decoration-[var(--color-subtle)] transition-colors duration-200 hover:bg-[var(--color-hover)] hover:text-[var(--color-text)] focus-visible:bg-[var(--color-hover)] focus-visible:text-[var(--color-text)]" href={font.href}>{font.source}</a>
              </dd>
            </div>
          </dl>
        </article>
      ))}
    </div>
  </section>
</Layout>
